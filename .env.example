# PayPal sandbox only. Obtain these from an existing PayPal developer account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Nebius Token Factory, OpenAI-compatible API. Keep the key on the server.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nvidia-nemotron-3-nano-30b-a3b

# Off by default; only enable for private, controlled PayPal sandbox tests.
ENABLE_SANDBOX_CAPTURE=false
