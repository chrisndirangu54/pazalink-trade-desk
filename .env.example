# PayPal sandbox only. Obtain these from an existing PayPal developer account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Nebius Token Factory, OpenAI-compatible API. Keep the key on the server.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nvidia-nemotron-3-nano-30b-a3b

# Off by default; only enable for private, controlled PayPal sandbox tests.
ENABLE_SANDBOX_CAPTURE=false

# DEVELOPMENT ONLY. Generate unique >=24 character tokens; format username:token,...
# Do not use these static demo tokens for public or production authentication.
PAZALINK_DEMO_TOKENS=
PAZALINK_DB_PATH=pazalink-demo.sqlite3
