# Only sandbox API credentials. Never commit secrets.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
ENABLE_SANDBOX_CAPTURE=false

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Backend Firebase Admin SDK. Use GOOGLE_APPLICATION_CREDENTIALS pointing to a
# private JSON credentials file outside the repository, or ADC in trusted hosting.
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/service-account.json

# Firebase browser identifiers (not server credentials)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Enables a loopback-only rules demo; never enables provider calls or payments.
ENABLE_LOCAL_RULES_DEMO=false
